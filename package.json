{
  "name": "ds-auths-plugin",
  "version": "0.2.0",
  "description": "Fail-closed authentication gateway for DeepSeek Harness Web",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "authentication",
    "security"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./webserver": {
      "types": "./lib/webserver.d.ts",
      "default": "./lib/webserver.js"
    },
    "./package.json": "./package.json",
    "./startup": {
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "preview": "node scripts/preview.mjs",
    "start": "node scripts/preview.mjs",
    "verify:preview": "node scripts/verify-preview.mjs",
    "prepack": "pnpm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "22.20.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-cmdline": "0.2.1-rc.3",
    "commander": "^15.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RGardenia/ds-auths-plugin.git"
  },
  "homepage": "https://github.com/RGardenia/ds-auths-plugin#readme",
  "bugs": {
    "url": "https://github.com/RGardenia/ds-auths-plugin/issues"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
