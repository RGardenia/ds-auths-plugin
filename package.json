{
  "name": "ds-auths-plugin",
  "version": "0.1.0-alpha.1",
  "description": "Fail-closed authentication gateway for DeepSeek Harness Web",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "authentication",
    "security"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./webserver": {
      "types": "./lib/webserver.d.ts",
      "default": "./lib/webserver.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "preview": "node scripts/preview.mjs",
    "start": "node scripts/preview.mjs",
    "verify:preview": "node scripts/verify-preview.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "22.20.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
